{
  "rules": [
    {
      "outbound": "block",
      "name": "🛑 Adblock",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "acl:BanAD",
        "geosite:category-ads"
      ]
    },
    {
      "outbound": "block",
      "name": "🍃 AdblockPlus",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "acl:BanProgramAD",
        "acl:BanADCompany"
      ]
    },
    {
      "outbound": "block",
      "name": "🛑 malware",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "geosite:malware",
        "geoip:malware",
        "geoip:phishing",
        "geosite:phishing",
        "geosite:cryptominers"
      ]
    },
    {
      "outbound": "direct",
      "name": "🍎 Apple",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "geosite:apple",
        "geosite:apple@ads",
        "geosite:apple-dev",
        "geosite:apple-pki",
        "geosite:apple-update"
      ]
    },
    {
      "outbound": "currentSelected",
      "name": "📲 Discord",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "geosite:discord",
        "acl:Discord"
      ]
    },
    {
      "outbound": "currentSelected",
      "name": "📲 WhatsApp",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "geosite:whatsapp",
        "acl:Whatsapp"
      ],
      "package": [
        "com.whatapp"
      ]
    },
    {
      "outbound": "currentSelected",
      "name": "📲 Telegram",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "geoip:telegram",
        "geosite:telegram"
      ],
      "package": [
        "org.telegram.messenger.web",
        "org.telegram.messenger"
      ]
    },
    {
      "outbound": "currentSelected",
      "name": "🌏 GFW",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "geoip:blocked@ru",
        "geoip:blocked-community@ru",
        "geosite:blocked@ru"
      ]
    },
    {
      "outbound": "currentSelected",
      "name": "🌏 Google",
      "switch": true,
      "or": true,
      "rule_set_build_in": [
        "geosite:google",
        "geoip:google"
      ]
    }
  ]
}